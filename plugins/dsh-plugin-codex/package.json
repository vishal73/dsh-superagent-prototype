{
  "name": "dsh-plugin-codex",
  "version": "0.1.0",
  "private": true,
  "description": "Codex CLI delegation for DeepSeek Harness: a `codex` tool, a `codex-wrap` command, and the model/effort shorthands this deployment uses.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "codex-wrap": "./bin/codex-wrap.mjs"
  },
  "dsh": {

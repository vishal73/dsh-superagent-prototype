      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
